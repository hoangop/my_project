# Degree Constraints for MTSP (k salespeople)

# For vertex 0 (start/end point):
# k edges must leave vertex 0
sum(x_0_j for j in range(1, n)) == k

# k edges must enter vertex 0
sum(x_i_0 for i in range(1, n)) == k

# For other vertices i (from 1 to n-1):
# Exactly one edge must enter vertex i
for i in range(1, n):
    sum(x_j_i for j in range(n) if j != i) == 1

# Exactly one edge must leave vertex i
for i in range(1, n):
    sum(x_i_j for j in range(n) if j != i) == 1